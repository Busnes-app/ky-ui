{
  "name": "@busnes/ky-ui",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Shared Busnes theme tokens and accessible navigation primitives for Ky web products.",
  "type": "module",
  "exports": {
    ".": "./src/theme.js",
    "./tokens.css": "./src/tokens.css",
    "./navigation.css": "./src/navigation.css"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test",
    "test:browser": "playwright test",
    "check:suite": "node scripts/check-suite.mjs",
    "sync:consumers": "node scripts/sync-consumers.mjs",
    "check:consumers": "node scripts/sync-consumers.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
